# ---- App ----
# Full URL of the deployment (no trailing slash). Used by the logout redirect.
# Local: http://localhost:3000  |  Prod: https://tu-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. If set, the UI is protected with HTTP Basic Auth (user: admin, password: this value).
APP_PASSWORD=
# Secret required to call the cron endpoint (/api/cron/publish?secret=...). Use a long random string.
CRON_SECRET=change-me-to-a-long-random-string

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- LinkedIn ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must match EXACTLY one of the Authorized redirect URLs in your LinkedIn app.
# Local: http://localhost:3000/api/auth/linkedin/callback
# Prod:  https://your-app.vercel.app/api/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
# LinkedIn versioned APIs date header (YYYYMM). Bump if LinkedIn deprecates it.
LINKEDIN_VERSION=202409
